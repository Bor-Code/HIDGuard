<UserControl x:Class="HidGuard.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SİSTEM SAVUNMA DURUMU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                <TextBlock Text="{Binding StatusText, Converter={StaticResource TurkishStatusConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Gerçek Zamanlı Donanım Koruması" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        <TextBlock Text="Düşük seviyeli klavye kancası ve donanım doğrulama devrede. Yetkisiz BadUSB cihazları ve anormal enjeksiyonlar engellenir." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding ToggleProtectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8"
                            VerticalAlignment="Center">
                        <TextBlock Text="Korumayı Aç/Kapat" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOPLAM TUŞ VURUŞU" Style="{StaticResource MetricLabelText}"/>
                        <TextBlock Text="{Binding TotalKeystrokes}" Style="{StaticResource MetricValueText}" Margin="0,8,0,0"/>
                        <TextBlock Text="İşlenen ve doğrulanan" Style="{StaticResource MetricNoteText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="ENGELLENEN TUŞLAR" Style="{StaticResource MetricLabelText}"/>
                        <TextBlock Text="{Binding SuppressedKeystrokes}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Kanca ile düşürüldü" Style="{StaticResource MetricNoteText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="TESPİT EDİLEN SALDIRILAR" Style="{StaticResource MetricLabelText}"/>
                        <TextBlock Text="{Binding AttacksDetected}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Anomali eşiğini aştı" Style="{StaticResource MetricNoteText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ETKİSİZ HALE GETİRİLENLER" Style="{StaticResource MetricLabelText}"/>
                        <TextBlock Text="{Binding ThreatsNeutralized}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Karşı önlem uygulandı" Style="{StaticResource MetricNoteText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CANLI YAZMA HIZI" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center"/>
                            <TextBlock Text="Pencere: 30 Tuş" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="{Binding CurrentWpm}" Style="{StaticResource MetricValueText}"/>
                            <TextBlock Text="WPM" Style="{StaticResource MetricUnitText}"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding CurrentWpm}" Maximum="220" Style="{StaticResource MeterBarStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Fizyolojik insan yazma sınırı ~160 WPM'dir. Otomatik BadUSB enjeksiyonları genellikle 1.000+ WPM hızına ulaşır." Style="{StaticResource MetricNoteText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="GÜNCEL ANOMALİ SKORU" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center"/>
                            <TextBlock Text="Eşik: %65" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="{Binding LatestAnomalyScore}" Style="{StaticResource MetricValueText}"/>
                            <TextBlock Text="%" Style="{StaticResource MetricUnitText}"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding LatestAnomalyScore}" Maximum="100" Style="{StaticResource MeterBarStyle}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Son 30 tuş aralığının varyasyon katsayısı ve insan-altı aralık oranı istatistiksel olarak değerlendirilir." Style="{StaticResource MetricNoteText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Son Güvenlik Olayları" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                        <Button Command="{Binding ClearStatsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11">
                            <TextBlock Text="İstatistikleri Sıfırla" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding BadgeColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EventTypeName, Converter={StaticResource TurkishStatusConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTimestamp}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
