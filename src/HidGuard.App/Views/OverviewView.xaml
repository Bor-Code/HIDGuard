<UserControl x:Class="HidGuard.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="12" Background="#162235" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Fill="{Binding StatusColor}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="HARDWARE INTERCEPTION SHIELD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="REAL-TIME" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Continuous low-level keystroke telemetry active. Microsecond cadence analysis and BadUSB hardware isolation enabled." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding ToggleProtectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLock}" Fill="#0B0F19" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Toggle Protection" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="INGESTED KEYS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#162E3B" CornerRadius="8" Width="30" Height="30">
                                <Path Data="{StaticResource IconKeyboard}" Fill="{StaticResource AccentCyanBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalKeystrokes}" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" Margin="0,8,0,2"/>
                        <TextBlock Grid.Row="2" Text="Verified manual cadence" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="5,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="KEYS SUPPRESSED" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#382E1E" CornerRadius="8" Width="30" Height="30">
                                <Path Data="{StaticResource IconBan}" Fill="{StaticResource AccentAmberBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding SuppressedKeystrokes}" FontSize="26" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" Margin="0,8,0,2"/>
                        <TextBlock Grid.Row="2" Text="Low-level hook dropped" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="5,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="ATTACKS DETECTED" FontSize="11" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#3B1C1F" CornerRadius="8" Width="30" Height="30">
                                <Path Data="{StaticResource IconCrosshair}" Fill="{StaticResource AccentRedBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding AttacksDetected}" FontSize="26" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold" Margin="0,8,0,2"/>
                        <TextBlock Grid.Row="2" Text="Timing anomalies identified" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="NEUTRALIZED" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#16382E" CornerRadius="8" Width="30" Height="30">
                                <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentEmeraldBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding ThreatsNeutralized}" FontSize="26" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" Margin="0,8,0,2"/>
                        <TextBlock Grid.Row="2" Text="Countermeasures enforced" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGauge}" Fill="{StaticResource AccentCyanBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE TYPING CADENCE" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="Window: 30 Keys" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentWpm}" FontSize="32" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                            <TextBlock Text=" WPM" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding CurrentWpm}" Maximum="220" Height="6" Foreground="{StaticResource AccentCyanBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock Text="Physiological human typing ceiling is ~160 WPM. BadUSB emulators typically exceed 1,000 WPM." FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconActivity}" Fill="{StaticResource AccentAmberBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CURRENT ANOMALY SCORE" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="Threshold: 65%" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LatestAnomalyScore}" FontSize="32" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                            <TextBlock Text=" %" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding LatestAnomalyScore}" Maximum="100" Height="6" Foreground="{StaticResource AccentRedBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock Text="Evaluates sub-human interval ratio, coefficient of variation, and cadence regularity." FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAudit}" Fill="#A78BFA" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Recent Security Events" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding ClearStatsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset Statistics" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding BadgeColor}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EventTypeName}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTimestamp}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
