<UserControl x:Class="HidGuard.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Connected Input Hardware" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                    <TextBlock Text="Manage hardware trust levels to prevent unauthorized or synthetic keystroke injection." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh Hardware List"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DataGrid ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="TRUST STATUS" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TrustBadgeColor}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" Margin="4">
                                    <TextBlock Text="{Binding TrustBadgeText}" Foreground="#0B0F19" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="HARDWARE IDENTIFIER" Binding="{Binding HardwareId}" Width="220"/>
                    <DataGridTextColumn Header="DEVICE PATH" Binding="{Binding DeviceId}" Width="*"/>

                    <DataGridTemplateColumn Header="ACTIONS" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Button Content="Trust"
                                            Command="{Binding TrustCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,4"
                                            Margin="0,0,4,0"
                                            FontSize="11"/>
                                    <Button Content="Block"
                                            Command="{Binding BlockCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="10,4"
                                            Margin="0,0,4,0"
                                            FontSize="11"/>
                                    <Button Content="Reset"
                                            Command="{Binding ResetTrustCommand}"
                                            Style="{StaticResource NavButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
