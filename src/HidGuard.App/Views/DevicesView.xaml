<UserControl x:Class="HidGuard.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Connected Input Devices" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Manage hardware-level trust for connected keyboards. Prevent BadUSB keystroke injection by restricting unauthorized devices." Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Refresh List" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      Style="{StaticResource TableStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="TRUST STATUS" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TrustBadgeColor}" CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" Margin="4,2">
                                    <TextBlock Text="{Binding TrustBadgeText, Converter={StaticResource TurkishStatusConverter}}" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="DEVICE NAME" Binding="{Binding DisplayName}" Width="200"/>

                    <DataGridTemplateColumn Header="HARDWARE ID" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HardwareId}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="DEVICE PATH" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeviceId}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ACTIONS" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2" VerticalAlignment="Center">
                                    <Button Content="Trust"
                                            Command="{Binding TrustCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="8,3"
                                            Margin="0,0,4,0"
                                            FontSize="11"
                                            MinHeight="26"/>
                                    <Button Content="Block"
                                            Command="{Binding BlockCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="8,3"
                                            Margin="0,0,4,0"
                                            FontSize="11"
                                            MinHeight="26"/>
                                    <Button Content="Enable"
                                            Command="{Binding ReEnableCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,3"
                                            Margin="0,0,4,0"
                                            FontSize="11"
                                            MinHeight="26"/>
                                    <Button Content="Reset"
                                            Command="{Binding ResetTrustCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"
                                            MinHeight="26"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
