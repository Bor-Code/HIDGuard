<UserControl x:Class="HidGuard.App.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1050">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource AccentAmberBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Attack Simulator and Security Research Studio" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Simulate BadUSB keystroke injection attacks, benchmark human variance, and verify active defense mitigations."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="14,8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#064E3B" CornerRadius="6" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentEmeraldBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="INJECTION SAFETY CONTROLS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Safe Dry-Run simulates timing loops and calculates metrics without dispatching real keystrokes to Windows."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Safe Dry-Run Mode (Recommended)"
                                  IsChecked="{Binding IsDryRun}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Countdown:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Width="45"
                                     HorizontalContentAlignment="Center"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                            <TextBlock Text="s" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCrosshair}" Fill="{StaticResource AccentAmberBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ATTACK PROFILES" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding AvailableProfiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}"/>
                                                            <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Row="0" Grid.Column="0" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{Binding BadgeColor}"/>
                                                        <Setter Property="Data" Value="{StaticResource IconTerminal}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="burst">
                                                                <Setter Property="Data" Value="{StaticResource IconLightning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="jitter">
                                                                <Setter Property="Data" Value="{StaticResource IconCpu}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="human">
                                                                <Setter Property="Data" Value="{StaticResource IconUser}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="stealth">
                                                                <Setter Property="Data" Value="{StaticResource IconAlert}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="staged">
                                                                <Setter Property="Data" Value="{StaticResource IconLayers}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ducky">
                                                                <Setter Property="Data" Value="{StaticResource IconCode}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="verify">
                                                                <Setter Property="Data" Value="{StaticResource IconShieldCheck}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Row="0" Grid.Column="2" CornerRadius="4" Padding="6,2" Background="#111827" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="{StaticResource AccentCyanBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PROFILE PARAMETERS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStandardProfileSelected, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Keystroke Count:" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding KeystrokeCount, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Interval Pace (ms):" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsDuckyScriptSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Quick Presets:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="Hello" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCode}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Hello" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="RunCmd" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource AccentAmberBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Run CMD" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="PowerShell" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLightning}" Fill="{StaticResource AccentCyanBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PowerShell" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="Recon" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCrosshair}" Fill="#A78BFA" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Recon" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <TextBlock Text="Payload Script:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DuckyScriptText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="140"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsVerificationSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Runs 7 automated security verification scenarios against an isolated synthetic input pipeline to certify burst attack neutralization, low-jitter uniformity detection, human passthrough, and the privacy invariant."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding ExecuteCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="#0B0F19" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Execute Attack" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconStop}" Fill="#F9FAFB" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource AccentEmeraldBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="EXECUTION CONSOLE OUTPUT" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ClearConsoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Clear Console" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBox Grid.Row="1"
                                     Text="{Binding OutputConsole, Mode=OneWay}"
                                     Height="250"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Background="#0B0F19"
                                     Foreground="#34D399"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Visibility="{Binding HasVerificationResults, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentCyanBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AUTOMATED VERIFICATION TEST RESULTS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding VerificationScenarios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Path Grid.Row="0" Grid.Column="0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="{Binding StatusColor}"/>
                                                            <Setter Property="Data" Value="{StaticResource IconRefresh}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                                    <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                                    <Setter Property="Data" Value="{StaticResource IconClose}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                <Border Grid.Row="0" Grid.Column="4" CornerRadius="4" Padding="8,2" Background="#111827" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Black" Foreground="{Binding StatusColor}"/>
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
