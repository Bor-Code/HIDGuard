<UserControl x:Class="HidGuard.App.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Saldırı Simülatörü ve Test Stüdyosu" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="BadUSB tuş enjeksiyon saldırılarını test edin, insan klavye dinamiklerini kıyaslayın ve aktif savunma mekanizmalarını doğrulayın."
                                   Style="{StaticResource PageSubtitleText}"/>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="4" Padding="12,6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText, Converter={StaticResource TurkishStatusConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="GÜVENLİK KONTROLLERİ" Style="{StaticResource MetricLabelText}"/>
                        <TextBlock Text="Güvenli simülasyon modu, işletim sistemine gerçek tuş göndermeden zamanlama döngülerini ve analiz metriklerini çalıştırır."
                                   Style="{StaticResource SectionHintText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Güvenli Simülasyon Modu (Önerilen)"
                                  IsChecked="{Binding IsDryRun}"
                                  Style="{StaticResource FormCheckBoxStyle}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,24,0"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Geri Sayım:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Width="48"
                                     HorizontalContentAlignment="Center"
                                     Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock Text="sn" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCrosshair}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SALDIRI PROFİLLERİ" Style="{StaticResource SectionTitleText}"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding AvailableProfiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Row="0" Grid.Column="0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Data" Value="{StaticResource IconTerminal}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="burst">
                                                                <Setter Property="Data" Value="{StaticResource IconLightning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="jitter">
                                                                <Setter Property="Data" Value="{StaticResource IconCpu}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="human">
                                                                <Setter Property="Data" Value="{StaticResource IconUser}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="stealth">
                                                                <Setter Property="Data" Value="{StaticResource IconAlert}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="staged">
                                                                <Setter Property="Data" Value="{StaticResource IconLayers}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ducky">
                                                                <Setter Property="Data" Value="{StaticResource IconCode}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="verify">
                                                                <Setter Property="Data" Value="{StaticResource IconShieldCheck}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title, Converter={StaticResource TurkishStatusConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Row="0" Grid.Column="2" CornerRadius="3" Padding="6,2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category, Converter={StaticResource TurkishStatusConverter}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description, Converter={StaticResource TurkishStatusConverter}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSliders}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PROFİL PARAMETRELERİ" Style="{StaticResource SectionTitleText}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStandardProfileSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tuş Vuruşu Adedi:" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding KeystrokeCount, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource InputTextBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Vuruş Aralığı (ms):" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource InputTextBoxStyle}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsDuckyScriptSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Hazır Şablonlar:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="Hello" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCode}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Selam" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="RunCmd" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CMD Çalıştır" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="PowerShell" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLightning}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PowerShell" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadPresetCommand}" CommandParameter="Recon" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCrosshair}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Keşif" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <TextBlock Text="Yük Betiği (DuckyScript):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DuckyScriptText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="140"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Style="{StaticResource InputTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsVerificationSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Yalıtılmış sentetik girdi hattı üzerinde 7 otomatik güvenlik senaryosunu çalıştırarak seri saldırı engelleme, düşük sapmalı düzenlilik tespiti, insan yazımı geçişi ve gizlilik ilkelerini denetler."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding ExecuteCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Saldırıyı Başlat" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="38">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconStop}" Fill="{StaticResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Durdur" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="KONSOL ÇIKTISI" Style="{StaticResource SectionTitleText}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ClearConsoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Konsolu Temizle" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBox Grid.Row="1"
                                     Text="{Binding OutputConsole, Mode=OneWay}"
                                     Height="270"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Background="#16243A"
                                     Foreground="#E2E8F0"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="12"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding HasVerificationResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OTOMATİK DOĞRULAMA TEST SONUÇLARI" Style="{StaticResource SectionTitleText}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding VerificationScenarios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Path Grid.Row="0" Grid.Column="0" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="{Binding StatusColor}"/>
                                                            <Setter Property="Data" Value="{StaticResource IconRefresh}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                                    <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                                    <Setter Property="Data" Value="{StaticResource IconClose}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name, Converter={StaticResource TurkishStatusConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                <Border Grid.Row="0" Grid.Column="4" CornerRadius="3" Padding="8,2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource TurkishStatusConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
