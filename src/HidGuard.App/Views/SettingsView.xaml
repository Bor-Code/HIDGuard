<UserControl x:Class="HidGuard.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="SECURITY ENGINE CONFIGURATION" Style="{StaticResource MetricLabelText}" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="PERSISTENT CONFIGURATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Security Configuration &amp; Engine Settings" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="Configure timing analysis sensitivity, visual themes, automated countermeasures, and system tray integration."
                                   Style="{StaticResource PageSubtitleText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ResetDefaultsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUndo}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset to Defaults" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding FeedbackMessage, Converter={StaticResource TurkishStatusConverter}}"
                       Foreground="{Binding FeedbackColor}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="4,0,0,14"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSliders}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Appearance &amp; Color Theme" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="3 High-Contrast Cybersecurity Themes" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Theme}" Value="RedBlack">
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                            <Setter Property="Background" Value="#2A1316"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <RadioButton GroupName="AppThemeSettingsGroup"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RedBlack}"
                                         Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Crimson Dark" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="#450A0A" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                            <TextBlock Text="Default" FontSize="9" FontWeight="Bold" Foreground="#FCA5A5"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Dark obsidian surface with crimson defensive accents." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Theme}" Value="GreenBlack">
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                            <Setter Property="Background" Value="#0D2B1E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <RadioButton GroupName="AppThemeSettingsGroup"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=GreenBlack}"
                                         Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Emerald Matrix" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Terminal dark surface with emerald green accents." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border Grid.Column="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Theme}" Value="BlueBlack">
                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                            <Setter Property="Background" Value="#0F2042"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <RadioButton GroupName="AppThemeSettingsGroup"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BlueBlack}"
                                         Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cobalt Night" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Deep dark surface with cobalt blue accents." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSliders}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Timing Detection Thresholds" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Rhythm &amp; Statistical Limits" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sliding Window Size" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Number of consecutive keystroke intervals evaluated for analysis." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding WindowSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Human Physiological Floor (ms)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Minimum interval physiologically possible for human typing." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding HumanFeasibilityFloorMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sub-Human Ratio Threshold" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Ratio of impossibly fast intervals that triggers an alert (0.0 - 1.0)." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SubHumanRatioThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Coefficient of Variation Threshold" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Regularity threshold indicative of robotic keystrokes." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding CoefficientOfVariationThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Suspicion Score Alarm Threshold" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Cumulative anomaly confidence score threshold triggering action (0 - 100)." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SuspicionScoreThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShieldCheck}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Active Defense &amp; Countermeasures" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Immediate Interception &amp; Mitigation Actions" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="Lock Windows workstation immediately upon attack detection"
                              IsChecked="{Binding LockWorkstationEnabled}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Disable malicious USB device at the PnP devnode level"
                              IsChecked="{Binding DeviceDisableEnabled}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Suppress and swallow injected keystrokes via low-level keyboard hook"
                              IsChecked="{Binding KeySuppressionEnabled}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Temporary Keystroke Suppression Duration (Seconds)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Duration keystrokes are swallowed before reaching the OS during an alert." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding TemporarySuppressionSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDatabase}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Encrypted Incident Store &amp; Forensic Trail" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Local Incident Repository Protected with Windows DPAPI" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="Capture and encrypt attack keystrokes as forensic evidence (DPAPI)"
                              IsChecked="{Binding EnableOptInPayloadCapture}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Capture Keystroke Window Size" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Number of preceding keystrokes preserved in encrypted payload (1 - 1024)." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding CaptureWindowKeystrokes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Maximum Incident Retention Count" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Maximum number of incidents preserved before oldest are purged." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding MaxIncidentCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Incident Retention Period (Days)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Automatic purging threshold for expired incident records." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Maximum Payload Size (Bytes)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Maximum encrypted payload size allowed per incident." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding MaxPayloadBytes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Periodic Maintenance Interval (Minutes)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Frequency of background cleanup execution for expired logs." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding PurgeIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBell}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Application &amp; System Tray Options" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Windows Integration" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="Launch HIDGuard automatically on Windows startup (User Logon)"
                              IsChecked="{Binding StartWithWindows}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Start minimized to the system tray"
                              IsChecked="{Binding StartMinimizedToTray}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Show Windows desktop notification when a device is blocked"
                              IsChecked="{Binding NotifyOnBlockedDevices}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Show Windows desktop notification when a trusted device connects"
                              IsChecked="{Binding NotifyOnAllowedDevices}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
