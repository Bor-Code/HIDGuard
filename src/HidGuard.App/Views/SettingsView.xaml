<UserControl x:Class="HidGuard.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSettings}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="GÜVENLİK MOTORU YAPILANDIRMASI" Style="{StaticResource MetricLabelText}" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="KALICI YAPILANDIRMA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Güvenlik Yapılandırması ve Motor Ayarları" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="Zamanlama analizi hassasiyeti, otomatik savunma eylemleri ve sistem tepsisi entegrasyonunu yapılandırın."
                                   Style="{StaticResource PageSubtitleText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ResetDefaultsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUndo}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Varsayılanlara Sıfırla" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ayarları Kaydet" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding FeedbackMessage, Converter={StaticResource TurkishStatusConverter}}"
                       Foreground="{Binding FeedbackColor}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="4,0,0,14"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSliders}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Zamanlama Algılama Eşikleri" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Ritim ve İstatistiki Sınırlar" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hareketli Pencere Boyutu" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Dinamik analiz için değerlendirilen ardışık tuş aralıkları adedi." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding WindowSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="İnsan Fizyolojik Alt Sınırı (ms)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Manuel klavye yazımı için fizyolojik olarak mümkün olan asgari süre." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding HumanFeasibilityFloorMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="İnsan-Altı Hız Oranı Eşiği" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Alarm üretecek imkansız hızdaki aralıkların oranı (0.0 - 1.0)." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SubHumanRatioThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Varyasyon Katsayısı Eşiği" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Mekanik ve robotik tuşlamaları işaretleyen düzenlilik oranı eşiği." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding CoefficientOfVariationThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Şüphe Skoru Alarm Eşiği" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Müdahale tetikleyen toplam anomali güven skoru eşiği (0 - 100)." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SuspicionScoreThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Aktif Savunma ve Karşı Önlemler" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Anında Müdahale ve Engelleme Eylemleri" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="Saldırı tespit edildiğinde Windows oturumunu anında kilitle"
                              IsChecked="{Binding LockWorkstationEnabled}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Zararlı USB donanımını PnP aygıt düğümünden devre dışı bırak"
                              IsChecked="{Binding DeviceDisableEnabled}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Enjekte edilen tuşları klavye kancasıyla (hook) yut ve engelle"
                              IsChecked="{Binding KeySuppressionEnabled}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Geçici Tuş Yutma Süresi (Saniye)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Alarm esnasında tuşların işletim sistemine iletilmeden yutulacağı süre." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding TemporarySuppressionSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDatabase}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Şifreli Olay Deposu ve Adli Delil" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Windows DPAPI ile Korunan Yerel Olay Kaydı" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="Saldırı anında tetikleyici tuşları şifreleyerek adli delil olarak sakla (DPAPI)"
                              IsChecked="{Binding EnableOptInPayloadCapture}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kayıt Tuş Pencere Boyutu" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Şifreli delil kaydında saklanan önceki tuş vuruşu adedi (1 - 1024)." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding CaptureWindowKeystrokes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Azami Saklanan Olay Sayısı" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Eski kayıtlar silinmeden önce tutulan maksimum olay sayısı." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding MaxIncidentCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Olay Saklama Süresi (Gün)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Süresi dolan olay kayıtlarının otomatik temizlenme periyodu." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Maksimum Veri Boyutu (Bayt)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Olay başına saklanabilecek azami şifreli yük boyutu." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding MaxPayloadBytes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Periyodik Temizlik Aralığı (Dakika)" Style="{StaticResource FieldLabelText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Süresi dolan kayıtların arka planda temizlenme sıklığı." Style="{StaticResource FieldHintText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding PurgeIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBell}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Uygulama ve Sistem Tepsisi Seçenekleri" Style="{StaticResource SectionTitleText}"/>
                        </StackPanel>
                        <TextBlock Text="Windows Entegrasyonu" Style="{StaticResource SectionHintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="HIDGuard'ı Windows başlangıcında otomatik çalıştır (Kullanıcı Girişi)"
                              IsChecked="{Binding StartWithWindows}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Başlatıldığında sistem tepsisine küçültülmüş olarak aç"
                              IsChecked="{Binding StartMinimizedToTray}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Donanım engellendiğinde Windows bildirimi göster"
                              IsChecked="{Binding NotifyOnBlockedDevices}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Güvenilen donanım bağlandığında Windows bildirimi göster"
                              IsChecked="{Binding NotifyOnAllowedDevices}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
