<UserControl x:Class="HidGuard.App.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding ThreatLevelColor}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Keystroke Dynamics Evaluation" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ThreatLevelText}" FontSize="13" Foreground="{Binding ThreatLevelColor}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                            <TextBlock Text="HUMAN CONFIDENCE" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock Text="{Binding HumanConfidenceScore}" FontSize="20" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold"/>
                                <TextBlock Text="%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="ANOMALY SCORE" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock Text="{Binding AnomalyScore}" FontSize="20" Foreground="{Binding ThreatLevelColor}" FontWeight="Bold"/>
                                <TextBlock Text="/100" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ESTIMATED SPEED" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CurrentWpm}" FontSize="26" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                            <TextBlock Text=" WPM" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="Threshold: > 180 WPM alert" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MEAN INTERVAL" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CurrentMeanIntervalMs}" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                            <TextBlock Text=" ms" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="Physical floor: 25 ms" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="VARIABILITY (CV)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CoefficientOfVariation}" FontSize="26" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Std Dev: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentStdDevIntervalMs}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text=" ms" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="SUB-HUMAN RATIO" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SubHumanRatioPercent}" FontSize="26" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold"/>
                            <TextBlock Text="%" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Min: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding MinimumIntervalMs}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text=" ms" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Hardware Timing Distribution Histogram" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Interval Density Across Keystroke Windows" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistogramBuckets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="6" Height="140"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Percentage, StringFormat='{}{0}%'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                    <Border Grid.Row="1" Width="36" Height="{Binding BarHeight}" Background="{Binding ColorBrush}" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                    <TextBlock Grid.Row="3" Text="{Binding Count, StringFormat='{}{0} keys'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Real-Time Keystroke Interval Stream Strip" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Last 30 Inter-Keystroke Durations" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding RecentSamples}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Height="100" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Bottom" Margin="3,0" ToolTip="{Binding IntervalMs, StringFormat='{}{0} ms'}">
                                        <Border Width="16" Height="{Binding BarHeight}" Background="{Binding Color}" CornerRadius="3" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DIAGNOSTIC SESSION TELEMETRY" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Active Hardware ID: " FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ActiveDeviceId}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Total Evaluated: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalEvaluations}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                            <TextBlock Text=" | Anomalies Flagged: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding AnomalyCount}" FontSize="12" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold"/>
                            <TextBlock Text=" | Continuous Burst: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding BurstLength}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Reset Diagnostics"
                            Command="{Binding ResetMetricsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center"
                            Padding="16,8"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
